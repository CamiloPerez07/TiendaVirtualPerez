@model List<TiendaVirtualPerez.Models.Producto>

<div class="container mt-4">

    <h2 class="mb-4 text-center">Productos</h2>
    <a class="btn btn-success mb-3" href="/Producto/Create">
        Nuevo Producto
    </a>

    <a class="btn btn-primary mb-3" href="/Producto/Carrito">
        Ver Carrito
    </a>

    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-3 mb-4">
                <div class="card h-100 shadow">

                    <img src="@(string.IsNullOrEmpty(item.ImagenUrl) ? "/imagenes/default.png" : item.ImagenUrl)"
                         class="card-img-top"
                         style="height:200px; object-fit:cover;" />

                    <div class="card-body">
                        <h5 class="card-title">@item.Nombre</h5>

                        <p class="card-text">
                            Precio: $@item.Precio <br />
                            Stock: @item.Stock <br />
                            Categoría: @item.Categoria?.Nombre
                        </p>

                        <a href="/Producto/Edit/@item.Id"
                           class="btn btn-warning btn-sm">Editar</a>

                        @if (Context.Session.GetString("Rol") == "Admin")
                        {
                            <a href="/Producto/Delete/@item.Id"
                               class="btn btn-danger btn-sm">Eliminar</a>
                        }
                        <hr>
                        <form asp-action="AgregarCarrito" method="post">

                            <input type="hidden" name="id" value="@item.Id" />

                            <input type="number" name="cantidad" value="1" min="1"
                                   class="form-control mb-2" />

                            <button class="btn btn-outline-success w-100">
                                Agregar al carrito
                            </button>

                        </form>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="text-center mt-4">
        <a href="/Home" class="btn btn-secondary btn-lg"
           style="padding: 12px 30px; font-size: 1.1rem; border-radius: 50px; transition: all 0.3s ease;">
            Página Principal
        </a>
    </div>

</div>

<style>
    .btn:hover {
        transform: scale(1.05);
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);
    }
</style>
@model List<TiendaVirtualPerez.Models.Producto>

<h2>Lista de Productos</h2>

<a class="btn btn-success" href="/Producto/Create">Nuevo Producto</a>
<br><br>
@foreach (var producto in Model)
{
    <div class="card" style="width: 18rem;">
    <img src="@producto.ImagenUrl" class="card-img-top" alt="...">
    <div class="card-body">
        <h5 class="card-title">@producto.Nombre</h5>
        <p class="card-text">Valor: @producto.Precio</p>
        <a class="btn btn-warning btn-sm" href="/Producto/Edit/@producto.Id">Editar</a>
        <a class="btn btn-danger btn-sm" href="/Producto/Delete/@producto.Id">Eliminar</a>
    </div>
        </div>
}
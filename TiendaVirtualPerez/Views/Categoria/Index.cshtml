@model List<TiendaVirtualPerez.Models.Categoria>

<h2>Lista de Categorias</h2>

<a class="btn btn-success" href="/Categoria/Create">Nuevo Producto</a>
<br><br>
<table class="table table-stripes table-bordered">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Nombre</th>
            <th>Descripcion</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var categoria in Model)
        {
            <tr>
                <td>@categoria.Id</td>
                <td>@categoria.Nombre</td>
                <td>@categoria.Descripcion</td>
                <td>
                    @if (!string.IsNullOrEmpty(categoria.Nombre))
                    {
                        <span class="text-success">Activa</span>
                    }
                    else
                    {
                        <span class="text-danger">Sin nombre</span>
                    }
                </td>
                <td>
                    <a class="btn btn-warning btn-sm" href="/Categoria/Edit/@categoria.Id">Editar</a>

                    <a class="btn btn-warning btn-sm" href="/Categoria/Delete/@categoria.Id">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>